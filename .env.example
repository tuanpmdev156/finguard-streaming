# GCP Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCS_BUCKET_NAME=finguard-streaming-data-lake
GOOGLE_APPLICATION_CREDENTIALS=./credentials/pipeline-sa-key.json

# PostgreSQL OLTP (Reference DB)
PG_HOST=localhost
PG_PORT=5432
PG_USER=finguard
PG_PASSWORD=finguard_pass
PG_DB=finguard_oltp

# Redpanda / Kafka Streaming
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_TOPIC_TRANSACTIONS=fin_transactions

# Alerting
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

