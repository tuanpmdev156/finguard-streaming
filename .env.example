# GCP Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCS_BUCKET_NAME=finguard-streaming-data-lake
BQ_DATASET_RAW=finguard_raw
# Leave empty on GCE VM to use ADC from metadata server; set path for local dev
GOOGLE_APPLICATION_CREDENTIALS=./credentials/pipeline-sa-key.json

# Cloud SQL Auth Proxy (GCP VM deployment)
CLOUDSQL_CONNECTION_NAME=your-gcp-project-id:us-central1:finguard-pg

# PostgreSQL OLTP (Reference DB)
# Local: PG_HOST=localhost | Cloud: PG_HOST=cloud-sql-proxy
PG_HOST=localhost
PG_PORT=5432
PG_USER=finguard
# On GCE VM, fetch from Secret Manager: gcloud secrets versions access latest --secret=finguard-pg-password
PG_PASSWORD=change_me_or_fetch_from_secret_manager
PG_DB=finguard_oltp

# Redpanda / Kafka Streaming & PySpark
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_TOPIC_TRANSACTIONS=fin_transactions
CHECKPOINT_BASE=data/checkpoints

# Airflow & dbt Configuration
# Generate new Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=generate_new_fernet_key_here
# Generate new Secret key: python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW__WEBSERVER__SECRET_KEY=generate_new_webserver_secret_key_here
AIRFLOW_BASE_URL=http://localhost:8080
AIRFLOW_DAG_SCHEDULE=@hourly
# Local: dev (keyfile) | Cloud: prod (oauth / ADC)
DBT_TARGET=dev

# Alerting & CI/CD
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
GITHUB_TOKEN=
GITHUB_REPO=tuanpmdev156/finguard-streaming
GITHUB_WORKFLOW_FILE=deploy-evidence.yml
GITHUB_BRANCH=main


